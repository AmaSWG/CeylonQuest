{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-routes": {
        "ClusterId": "identityCluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        }
      },
      "register": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "POST" ],
          "Path": "/api/auth/register"
        }
      }
      ,
      "login": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "POST" ],
          "Path": "/api/auth/login"
        }
      },
      "logout": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "POST" ],
          "Path": "/api/auth/logout"
        }
      }
      ,
      "providerApplications": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "POST" ],
          "Path": "/api/providerapplications"
        }
      }
      ,
      "provider-applications": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "POST" ],
          "Path": "/api/provider-applications"
        }
      }
      ,
      "provider-activate": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "POST" ],
          "Path": "/api/auth/provider/activate"
        }
      }
      ,
      "users-me-get": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "GET" ],
          "Path": "/api/users/me"
        }
      }
      ,
      "users-me-put": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "PUT" ],
          "Path": "/api/users/me"
        }
      }
      ,
      "provider-timeslots-collection": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "GET", "POST" ],
          "Path": "/api/provider/timeslots"
        }
      }
      ,
      "provider-timeslots-item": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "PUT", "DELETE" ],
          "Path": "/api/provider/timeslots/{**remainder}"
        }
      }
      ,
      "provider-prices-collection": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "GET", "POST" ],
          "Path": "/api/provider/prices"
        }
      }
      ,
      "provider-prices-item": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "PUT", "DELETE" ],
          "Path": "/api/provider/prices/{**remainder}"
        }
      }
      ,
      "provider-info": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "GET", "PUT" ],
          "Path": "/api/provider/info"
        }
      },
      "admin-routes": {
        "ClusterId": "identityCluster",
        "Match": {
          "Path": "/api/admin/{**remainder}"
        }
      }
    },
    "Clusters": {
      "identityCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5278/"
          }
        }
      }
    }
  }
}
