{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "register": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "POST" ],
          "Path": "/api/auth/register"
        }
      }
      ,
      "providerApplications": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "POST" ],
          "Path": "/api/providerapplications"
        }
      }
      ,
      "provider-applications": {
        "ClusterId": "identityCluster",
        "Match": {
          "Methods": [ "POST" ],
          "Path": "/api/provider-applications"
        }
      }
    },
    "Clusters": {
      "identityCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5278/"
          }
        }
      }
    }
  }
}
